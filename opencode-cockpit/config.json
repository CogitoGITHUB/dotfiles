{
  "statusline": {
    "surface": "bottom",
    "separator": " │ ",
    "icons": true,
    "commands": {
      "lanes": {
        "run": "sh ~/.config/opencode-cockpit/lanes.sh",
        "intervalMs": 10000,
        "timeoutMs": 1500,
        "claudeCodeCompat": false,
        "priority": 45
      }
    },
    "segments": [
      { "type": "session.status", "priority": 100 },
      { "type": "context", "style": "gradient", "width": 10, "priority": 95 },
      { "type": "tokens", "priority": 90 },
      { "type": "todo", "priority": 80 },
      { "type": "git.diff", "priority": 75 },
      { "type": "session.time", "priority": 50 },
      { "type": "command", "name": "lanes", "priority": 45 }
    ]
  }
}